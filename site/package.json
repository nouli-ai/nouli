{
  "name": "nouli-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "astro sync && oxlint --type-aware --deny-warnings",
    "typecheck": "astro check",
    "test:unit": "vitest run --project unit",
    "test:dist": "html-validate dist && vitest run --project dist",
    "test:e2e": "playwright test --project e2e",
    "check": "npm run format:check && npm run lint && npm run lint:shell && npm run typecheck && npm run test:unit && npm run build && npm run test:dist && npm run test:e2e",
    "lint:shell": "shellcheck public/install.sh tools/record-hero.sh"
  },
  "dependencies": {
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "html-validate": "^11.21.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "parse5": "^8.1.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": false
  }
}
