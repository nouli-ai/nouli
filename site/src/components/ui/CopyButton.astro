---
interface Props {
  /** The accessible name, such as "Copy the Homebrew install command". */
  label: string;
  /** Without the raised shadow, for buttons inside a labeled frame. */
  flat?: boolean;
}

const { label, flat = false } = Astro.props;
---

<!-- Used inside a <copy-text> element, which supplies the behavior. -->
<button class:list={["copy", { flat }]} type="button" aria-label={label} data-copy-button>
  copy
</button>
<span class="status" role="status" data-copy-status></span>

<style>
  .copy {
    flex: none;
    font: 400 11px var(--mono);
    font-stretch: 87%;
    background: none;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 4px 10px;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--rule);
  }
  .copy:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .copy[data-copied] {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--on-teal);
    box-shadow: none;
    transform: translateY(3px);
  }
  .copy:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .flat {
    box-shadow: none;
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import "../../client/copy-text";
</script>
