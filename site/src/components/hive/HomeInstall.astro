---
import { install, latestRelease } from "../../lib/site";
const rows = [
  { os: "macOS", code: install.homebrew, label: "Copy the Homebrew install command" },
  { os: "Linux", code: install.script, label: "Copy the download installer command" },
];
---

<div class="install" id="install">
  {rows.map(({ os, code, label }) => (
    <copy-text class="row">
      <span class="os">{os}</span>
      <code data-copy-source>{code}</code>
      <button type="button" class="copy" aria-label={label} data-copy-button>
        Copy
      </button>
      <span class="status" role="status" data-copy-status></span>
    </copy-text>
  ))}
  <p class="meta">
    <latest-release>
      <a data-latest-release href={latestRelease}>
        latest release
      </a>
    </latest-release>{" "}
    · Apple silicon macOS · Linux ARM64 and x86_64 ·{" "}
    <a href="/guide/#install">other ways to install</a>
  </p>
</div>
<script>
  import "../../client/copy-text";
  import "../../client/latest-release";
</script>

<style>
  .install {
    display: grid;
    gap: 8px;
    max-width: 600px;
    scroll-margin-top: 24px;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 7px 7px 7px 14px;
    border-radius: 14px;
    background: var(--sky-tint);
    border: 1px solid var(--sky-line);
    backdrop-filter: blur(10px);
  }
  .os {
    font: 500 11px var(--mono);
    font-stretch: 87%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-sky-soft);
  }
  code {
    font: 500 12.5px var(--mono);
    font-stretch: 87%;
    overflow-wrap: anywhere;
  }
  .copy {
    min-width: 64px;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 9px;
    border: 1px solid var(--sky-line);
    background: none;
    color: inherit;
    font: 500 12px var(--mono);
    font-stretch: 87%;
    cursor: pointer;
  }
  .copy:focus-visible {
    outline: 2px solid var(--on-sky);
    outline-offset: 2px;
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  latest-release {
    display: contents;
  }
  .meta {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--on-sky-soft);
  }
  .meta a {
    color: var(--on-sky);
    text-underline-offset: 3px;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .os {
      grid-column: 1 / -1;
    }
    code {
      font-size: 12px;
    }
  }
</style>
