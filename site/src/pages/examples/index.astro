---
import { getCollection } from "astro:content";
import HivePage from "../../components/hive/HivePage.astro";
import PageHead from "../../components/hive/PageHead.astro";
import { examplePath, inOrder, sampleRange } from "../../lib/examples";
import { countWord } from "../../lib/models";

const examples = inOrder(await getCollection("examples"));
const { min, max } = sampleRange(examples);
---

<HivePage
  title="Examples · Nouli"
  description="Decision networks run on real public data: vulnerability advisories, workplace injury reports, medical device reports, aviation safety reports and commercial contracts."
>
  <PageHead current="examples" kicker="Examples">
    <h1>Decision networks on real data</h1>
    <p>
      {countWord(examples.length)} public datasets, from security advisories to aviation safety
      reports. Each network ran on {min} to {max} real cases.
    </p>
  </PageHead>

  <section class="wrap">
    <ul class="cards">
      {examples.map(({ id, data }) => (
        <li>
          <a class="card" href={examplePath(id)}>
            <span class="chip">
              {data.industry} · {data.source.short}
            </span>
            <b>{data.title}</b>
            <span class="job">{data.job}</span>
            <em>
              {data.sample.count} {data.sample.unit}
            </em>
          </a>
        </li>
      ))}
    </ul>
  </section>
</HivePage>

<style>
  .wrap {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  section {
    padding: 64px 0 40px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 22px;
    border: 1px solid var(--hive-line);
    border-radius: 20px;
    background: var(--hive-card);
    color: inherit;
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--amber);
  }
  .card:focus-visible {
    outline: 2px solid var(--amber-ink);
    outline-offset: 3px;
  }
  .chip {
    width: max-content;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--amber-track);
    color: var(--amber-ink);
    font: 500 11px var(--mono);
    font-stretch: 87%;
    letter-spacing: 0.02em;
  }
  b {
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .job {
    color: var(--hive-soft);
  }
  em {
    margin-top: auto;
    padding-top: 10px;
    font: 400 12px var(--mono);
    font-stretch: 87%;
    font-style: normal;
    color: var(--amber-ink);
  }
</style>
